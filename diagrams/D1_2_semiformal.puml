@startuml D1_2_semiformal
' Figura 1.2 — Notación semiformal UML 2.x: ServicioIA y colaboradores
' Interfaces provistas (lollipop) sobre cada proveedor, dependencias
' «use»/«fallback»/«async» punteadas, composición (rombo relleno) para
' las partes del ServicioIA (subsystem). Mismo conjunto de elementos que
' 1.1 y 1.3 (contrato de alcance común). Nombres canónicos del documento.
' Base: ERS VITASMARTA v3.0 (RF-07-1/3/8, RF-08-4, RF-13-7, RD-03).
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 12
skinparam componentStyle uml2
skinparam ArrowThickness 1.4
skinparam nodesep 46
skinparam ranksep 52

component "«component»\nApiGateway" as GW #0F2B46;text:FFF

component "«subsystem»\nServicioIA" as IA #FBEAE4;line:E8614D {
  component "RecommendationEngine\n[híbrido: colaborativo\n+ contenido]" as ENG #FFF;line:E8614D
  component "FallbackHandler\n[RF-07-8]" as FBH #FFF6E3;line:E8A13D
  component "ExplainabilityModule\n[RF-07-3]" as EXM #FFF;line:E8614D
  ENG *-- FBH
  ENG *-- EXM
}

component "«component»\nServicioCatalogo" as SC #0E8A7D;text:FFF
component "«component»\nServicioIdentidad" as SI #0F2B46;text:FFF
component "«component»\nServicioAmbiental" as SA #2E7D4F;text:FFF
queue "«component»\nBusMensajes\n(RabbitMQ)" as BUS #FFF6E3;line:E8A13D

interface "IRecommendation" as IREC #E8614D
interface "ICatalogo" as ICAT #0E8A7D
interface "IPerfil" as IPER #0F2B46
interface "ISostenibilidad" as ISOS #2E7D4F

' Interfaces provistas: lollipop sobre cada proveedor
IA -up- IREC
SC -up- ICAT
SI -up- IPER
SA -up- ISOS

' Dependencias punteadas tipificadas
GW .right.> IREC : «use»\nGET /recommendations
IA .up.> ICAT : «use»
IA .up.> IPER : «use»
IA .up.> ISOS : «use»
ENG .[#E8A13D].> FBH : «fallback»
ENG .[#E8A13D].> BUS : «async»\nRecomendacionGenerada

IA -[hidden]down- BUS
GW -[hidden]down- IA
SC -[hidden]right- SI
SI -[hidden]right- SA

legend right
  <b>Notación UML 2.x</b>
  Lollipop ─○ interfaz provista · socket ─( requerida
  Dependencia punteada «use» / «fallback» / «async»
  Rombo relleno ◆— composición (partes del ServicioIA)

  <b>Trazabilidad ERS v3.0</b>
  RD-03 (IA independiente) · RF-07-1 (motor híbrido)
  RF-07-3 (explicable) · RF-07-8 (fallback) · RF-08-4 (perfil)
endlegend
@enduml
