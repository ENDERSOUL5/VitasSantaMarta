@startuml D2_4a_disponibilidad
' Figura 2.4a — Vista de Calidad: Disponibilidad (RNF-02, SLA ≥ 99 %).
' Estrategia diseñada para soportar el objetivo de SLA (Fase 4 la valida).
' Stakeholders: infraestructura, analista de calidad, administrador.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontSize 11
skinparam ArrowThickness 1.3
skinparam nodesep 26
skinparam ranksep 42

actor "Turista" as T #E6F4F6;line:0E8A7D

rectangle "Elementos con rol en DISPONIBILIDAD (RNF-02) — SLA ≥ 99 %" as FR #F4F9F4;line:2E7D4F {
  queue "RabbitMQ\n[at-least-once · RD-16]" as MQ #FFF6E3;line:E8A13D
  rectangle "API Gateway ×N\n[health check]" as GW #0F2B46;text:FFF
  rectangle "svc-catalogo ×3\n[réplicas lectura]" as CAT #0E8A7D;text:FFF
  rectangle "ACL + vistas\nmaterializadas\n[RF-10-4]" as ACL #0F2B46;text:FFF
  rectangle "«Circuit Breaker»\nsvc-integración" as CB #FFF6E3;line:E8A13D
  rectangle "Redis Cluster\n[TTL · soft lock]" as RC #FFF6E3;line:E8A13D
  rectangle "Health checks\n[/health · RNF-02-5]" as HC #E7F2EA;line:2E7D4F
  rectangle "Observabilidad\n[RNF-02-7]" as OBS #DFF0DF;line:2E7D4F
}

usecase "Fuente Externa\n(Inestable)" as FE #FBEAE4;line:B4443C

T -right-> GW : solicita
GW -[#E8A13D]-> MQ : síncrono\nasíncrono
GW -right-> CAT : enruta
CAT -right-> ACL : «read»
ACL -right-> CB
CB .[#B4443C].> FE : intenta
CAT -[#E8A13D]-> RC : «cache-first»
HC -[#2E7D4F]-> OBS

note bottom of CB
  Se abre en ≤ 10 s (RNF-02-3)
end note

note bottom of RC
  Último dato conocido (RF-10-4)
end note

note bottom of OBS
  Alerta si SLA < 99 %
end note

legend right
  <b>Trazabilidad ERS v3.0</b>
  RNF-02-1..7 (disponibilidad, CB, health checks, alertas)
  RF-10-4 (último dato conocido) · RD-16 (at-least-once)
endlegend
@enduml
